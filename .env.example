# Bu dosya SABLONDUR ve GitHub'a yuklenir.
# Kopyala:  cp .env.example .env   ve gercek degerleri .env'e yaz.
# .env ASLA commit edilmez (.gitignore'da).

FLASK_ENV=development
SECRET_KEY=buraya-uzun-rastgele-bir-metin
DATABASE_URL=smartlead.db
PORT=5001              # macOS: 5000 AirPlay Receiver tarafindan kullaniliyor

# --- Yapay zeka ---
AI_PROVIDER=groq
GROQ_API_KEY=gsk_BURAYA_KENDI_ANAHTARIN
AI_MODEL=qwen/qwen3.8-27b

# --- CORS: Wix sitenizin ORIGIN'i ---
# Origin = sema + host. YOL yazilmaz, sondaki / olmaz.
#   dogru  : https://kullaniciadi.wixstudio.com
#   yanlis : https://kullaniciadi.wixstudio.com/sayfaadi
# Gelistirme boyunca * kullanabilirsin. Birden fazlasi virgulle.
CORS_ORIGINS=*
